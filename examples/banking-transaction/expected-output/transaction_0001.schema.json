{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": [
    "eventId",
    "schemaId",
    "eventType",
    "eventTime",
    "eventTimezoneOffset",
    "eventSequenceNumber",
    "contentType",
    "transactionId",
    "objectType",
    "object"
  ],
  "properties": {
    "eventId": {
      "type": "string"
    },
    "schemaId": {
      "type": "string"
    },
    "eventType": {
      "type": "string"
    },
    "eventTime": {
      "type": "string",
      "format": "date-time"
    },
    "eventTimezoneOffset": {
      "type": "string"
    },
    "eventSequenceNumber": {
      "type": "integer"
    },
    "contentType": {
      "type": "string"
    },
    "transactionId": {
      "type": "integer"
    },
    "objectType": {
      "type": "string"
    },
    "object": {
      "$ref": "#/definitions/Object"
    }
  },
  "definitions": {
    "Object": {
      "type": "object",
      "required": [
        "Jade.oid",
        "Jade.instanceId",
        "Jade.edition",
        "id",
        "timestamp",
        "type",
        "amount",
        "k_symbol",
        "primary_account",
        "current_balance"
      ],
      "properties": {
        "Jade.oid": {
          "type": "string"
        },
        "Jade.instanceId": {
          "type": "integer"
        },
        "Jade.edition": {
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "type": "string"
        },
        "operation": {
          "type": ["string", "null"]
        },
        "amount": {
          "type": "number"
        },
        "k_symbol": {
          "type": "string"
        },
        "primary_account": {
          "$ref": "#/definitions/Account"
        },
        "counterparty_account": {
          "$ref": "#/definitions/Account"
        },
        "current_balance": {
          "type": "string"
        }
      }
    },
    "Account": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "district_id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "district_id": {
          "type": "integer"
        }
      }
    }
  }
}

