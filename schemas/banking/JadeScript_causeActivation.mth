jadeVersionNumber "99.0.00";
schemaDefinition
RootSchema subschemaOf null partialDefinition, systemSchema;
typeDefinitions
	JadeScript
	(
	jadeMethodDefinitions
		causeActivation(bundleId: String) systemOnly;

	)
typeSources
	JadeScript (
	jadeMethodSources
causeActivation
{
causeActivation(bundleId : String) systemOnly;
// bundleId expected format = "<xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx>
vars
	dbAdmin : JadeDatabaseAdmin;
begin
	create dbAdmin transient;
	dbAdmin.__previewJdrActivation(bundleId);
epilog
delete dbAdmin;
end;

}
	)
